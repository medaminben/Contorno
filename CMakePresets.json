{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 29, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "BUILD_TESTING": "ON"
      }
    },
    {
      "name": "default",
      "displayName": "Contorno release",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/default",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "debug",
      "displayName": "Contorno debug",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "coverage",
      "displayName": "Contorno coverage (gcov/lcov)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/coverage",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "ENABLE_COVERAGE": "ON"
      }
    },
    {
      "name": "asan",
      "displayName": "Contorno AddressSanitizer + UndefinedBehaviorSanitizer",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-sanitize-recover=undefined -fno-omit-frame-pointer",
        "CMAKE_EXE_LINKER_FLAGS": "-fsanitize=address,undefined",
        "CMAKE_SHARED_LINKER_FLAGS": "-fsanitize=address,undefined"
      }
    },
    {
      "name": "ci",
      "displayName": "Contorno CI",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/ci",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "deb",
      "displayName": "Contorno Debian package (cpack in build/deb)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/deb",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Linux" },
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "CMAKE_INSTALL_PREFIX": "/usr",
        "CMAKE_INSTALL_LIBDIR": "lib/contorno",
        "CMAKE_INSTALL_RPATH": "$ORIGIN;$ORIGIN/../lib/contorno"
      }
    },
    {
      "name": "windows-installer",
      "displayName": "Contorno Windows installer (MSVC, wxWidgets from vcpkg, Inno Setup)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build/windows-installer",
      "condition": { "type": "equals", "lhs": "${hostSystemName}", "rhs": "Windows" },
      "toolchainFile": "$env{VCPKG_INSTALLATION_ROOT}/scripts/buildsystems/vcpkg.cmake",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "BUILD_TESTING": "OFF",
        "VCPKG_TARGET_TRIPLET": "x64-windows"
      }
    }
  ],
  "buildPresets": [
    { "name": "default",  "configurePreset": "default" },
    { "name": "debug",    "configurePreset": "debug" },
    { "name": "coverage", "configurePreset": "coverage" },
    { "name": "asan",     "configurePreset": "asan" },
    { "name": "ci",       "configurePreset": "ci" },
    { "name": "deb",      "configurePreset": "deb" },
    { "name": "windows-installer", "configurePreset": "windows-installer" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "default",  "inherits": "base", "configurePreset": "default" },
    { "name": "debug",    "inherits": "base", "configurePreset": "debug" },
    { "name": "coverage", "inherits": "base", "configurePreset": "coverage" },
    {
      "name": "asan",
      "inherits": "base",
      "configurePreset": "asan",
      "environment": {
        "ASAN_OPTIONS": "detect_leaks=1:abort_on_error=1",
        "UBSAN_OPTIONS": "print_stacktrace=1:halt_on_error=1"
      }
    },
    { "name": "ci",       "inherits": "base", "configurePreset": "ci" }
  ]
}
